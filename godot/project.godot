; Engine configuration file.
config_version=5

[application]
config/name="RL Fight"
run/main_scene="res://viewer.tscn"
config/features=PackedStringArray("4.6", "GL Compatibility")

[display]
window/size/viewport_width=720
window/size/viewport_height=1280
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=1

[rendering]
renderer/rendering_method="gl_compatibility"
lights_and_shadows/directional_shadow/size=4096
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=3
anti_aliasing/quality/msaa_3d=2
limits/opengl/max_lights_per_object=24
limits/opengl/max_renderable_lights=48
textures/default_filters/anisotropic_filtering_level=3
renderer/rendering_method.mobile="gl_compatibility"
